# Frontend (Vite) — safe to commit as example only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Edge function secrets are set in Supabase Dashboard (not in this file):
# Edge function secrets (set in Supabase Dashboard → Edge Functions → Secrets):
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Tage Venture Capital <hello@tagevc.com>
# INTAKE_ALERT_EMAIL=hello@tagevc.com
#   (or your personal inbox if hello@ is only a brand/from address)
# SALES_PORTAL_URL=https://portal.tagevc.com
#   (local: http://localhost:5173 — production host is portal.tagevc.com)
# DRIP_CRON_SECRET=generate_a_long_random_string
# RESEND_WEBHOOK_SECRET=whsec_...
#   (from Resend → Webhooks → signing secret for resend-webhook edge function)
# CONTENT_CRON_SECRET=generate_a_long_random_string
# OPENAI_API_KEY=           # optional — AI blog/social generation
# OPENAI_MODEL=gpt-4o-mini
# LINKEDIN_CLIENT_ID=       # Phase 2 live social publish
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=

# Microsoft Graph / Outlook calendar (see SETUP_CALENDAR.md):
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=           # Directory (tenant) ID, or "common"
# MS_GRAPH_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/microsoft-calendar-oauth-callback
# MS_TOKEN_ENCRYPTION_KEY=      # openssl rand -hex 32
# MS_GRAPH_SCOPES=              # optional; default: openid offline_access User.Read Calendars.Read
# SALES_PORTAL_URL=https://portal.tagevc.com

