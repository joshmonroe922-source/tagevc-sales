# Frontend (Vite) — safe to commit as example only
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Edge function secrets are set in Supabase Dashboard (not in this file):
# Edge function secrets (set in Supabase Dashboard → Edge Functions → Secrets):
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=Tage Venture Capital <hello@tagevc.com>
# INTAKE_ALERT_EMAIL=hello@tagevc.com
#   (or your personal inbox if hello@ is only a brand/from address)
# SALES_PORTAL_URL=https://portal.tagevc.com
#   (local: http://localhost:5173 — production host is portal.tagevc.com)
# DRIP_CRON_SECRET=generate_a_long_random_string
# RESEND_WEBHOOK_SECRET=whsec_...
#   (from Resend → Webhooks → signing secret for resend-webhook edge function)
# CONTENT_CRON_SECRET=generate_a_long_random_string
# DIGEST_CRON_SECRET=generate_a_long_random_string
#   # auth for process-morning-digest (6 AM Today briefing — see SETUP_MORNING_DIGEST.md)
# OPENAI_API_KEY=           # optional — AI blog/social generation
# OPENAI_MODEL=gpt-4o-mini
# LINKEDIN_CLIENT_ID=       # Phase 2 live social publish
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=

# Microsoft Graph / Outlook calendar (see SETUP_CALENDAR.md):
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_TENANT_ID=           # Directory (tenant) ID, or "common"
# MS_GRAPH_REDIRECT_URI=https://YOUR_PROJECT_REF.supabase.co/functions/v1/microsoft-calendar-oauth-callback
# MS_TOKEN_ENCRYPTION_KEY=      # openssl rand -hex 32
# MS_GRAPH_SCOPES=              # optional; default includes … Mail.ReadWrite Mail.Send MailboxSettings.ReadWrite
#   # optional rooms: … Place.Read.All (Azure + admin consent)
#   # company Resumes vault: … Sites.ReadWrite.All (Azure + admin consent) + MS_COMPANY_SITE_PATH
# MS_COMPANY_SITE_PATH=         # Tage tenant root site: netorgft15674001.sharepoint.com
#   # (or a sub-site path like netorgft15674001.sharepoint.com:/sites/CompanyFiles if Josh creates one)
# MS_COMPANY_CREATE_NESTED=1    # nests "Company Files" folder under the site's default doc library
# MS_COMPANY_DRIVE_ID=
# MS_COMPANY_ROOT_ITEM_ID=
# SALES_PORTAL_URL=https://portal.tagevc.com
#
# Salesforce resume sync scaffold (see SETUP_SALESFORCE_RESUMES.md):
# SF_CLIENT_ID=
# SF_CLIENT_SECRET=
# SF_REFRESH_TOKEN=
# SF_CANDIDATE_OBJECT=Contact

# RingCentral Embeddable softphone + SMS (see SETUP_RINGCENTRAL.md):
# VITE_RINGCENTRAL_CLIENT_ID=          # RC Developer Console client ID (PKCE — no secret in frontend)
# VITE_RINGCENTRAL_APP_SERVER=         # optional; default https://platform.ringcentral.com
# Redirect URI to register on the RC app:
#   https://apps.ringcentral.com/integration/ringcentral-embeddable/latest/redirect.html

# Recruit 619 ↔ TalentDesk (see SETUP_RECRUIT619.md):
# VITE_TALENTDESK_ORIGIN=https://app.recruit619.com
# Supabase Edge secret (same value as TalentDesk PORTAL_SSO_SECRET):
# TALENTDESK_SSO_SECRET=
# Optional override for edge redirect host (defaults to https://app.recruit619.com):
# TALENTDESK_ORIGIN=https://app.recruit619.com
# Optional: comma-separated extras beyond @recruit619.com (mirror TalentDesk AUTH_ALLOWLIST on the edge):
# AUTH_ALLOWLIST=
# Portal @tagevc.com → TalentDesk same local-part @recruit619.com (see SETUP_RECRUIT619.md)
# TALENTDESK_MAP_DOMAINS=tagevc.com
# Optional explicit overrides: from=to,from2=to2
# TALENTDESK_EMAIL_MAP=

# Portfolio entity shell — Think Tank (Grok) + Instant NDA platform (see SETUP_THINK_TANK.md):
# VITE_INSTANT_NDA_SALES_URL=https://instantnda.us/sales/login
# VITE_INSTANT_NDA_APP_URL=https://app.instantnda.us
# VITE_SIGNENT_HR_URL=https://signenthr.com
# Edge secrets (Supabase Dashboard → Edge Functions → Secrets):
# XAI_API_KEY=                 # REQUIRED for Think Tank chat — Josh must set (server-side only)
# XAI_MODEL=grok-3-mini        # optional
# OWNER_OVERSIGHT_EMAIL=josh@… # Josh-only digest of Think Tank journals (personal + entity; not shown in UI)
# OWNER_OVERSIGHT_ENABLED=true # set false to disable oversight emails
# DIGEST_CRON_SECRET=          # process-morning-digest cron (see SETUP_MORNING_DIGEST.md)
# TICKET_INTAKE_SECRET=        # portal-ticket-intake (subsidiary → Tage; see docs/TICKETING_MULTI_PORTAL.md)
# TICKET_SYSTEM_USER_EMAIL=portal@tagevc.com  # fallback created_by for intake

