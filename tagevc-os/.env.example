# Supabase (required in production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_full_not_truncated

# Optional: server-side writes (webhooks, background persist). Prefer this in production.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App URL (OAuth redirects)
# NEXT_PUBLIC_APP_URL=https://app.tagevc.com

# Phase 9: prefer normalized os_* tables even when empty (read cutover / empty-snapshot drills)
# USE_NORMALIZED_TABLES=1

# Phase 15–16: snapshot write cutover (reversible; default = dual-write ON)
# WRITE_CUTOVER_MATURE=1
# WRITE_CUTOVER_ALL=1
# SNAPSHOT_SKIP_DOMAINS=deal_flow,tickets,documents,ma,re
# WRITE_SNAPSHOTS=0
# SNAPSHOT_WRITE_DOMAINS=ma,re

# Phase 16: Sentry (optional)
# SENTRY_DSN=https://…@o….ingest.sentry.io/…
# SENTRY_TRACES_SAMPLE_RATE=0.05

# Phase 13: email digests (optional)
# RESEND_API_KEY=re_xxx
# DIGEST_FROM_EMAIL=noreply@tagevc.com
# DIGEST_SECRET=long_random_shared_with_cron
# CRON_SECRET=same_or_separate

# Phase 14–16: protect admin APIs (DIGEST_SECRET / CRON_SECRET) or use admin session

# DocuSign Connect webhook shared secret (header: x-tagevc-webhook-secret)
# DOCUSIGN_WEBHOOK_SECRET=generate_a_long_random_string
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY=
# DOCUSIGN_CONNECT_HMAC_SECRET=

# Phase 21–24 Marketing
# MARKETING_AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# MARKETING_SCHEDULER_ENABLED=1
# MARKETING_TOKEN_SECRET=at_least_16_chars_for_aes
# MARKETING_FORCE_STUB_PUBLISH=0
# MARKETING_ALLOW_STUB_OAUTH=0
# MARKETING_ALLOW_STUB_PUBLISH=0
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ADS_API=0
# LINKEDIN_ADS_ACCESS_TOKEN=
# LINKEDIN_API_VERSION=202607
# LINKEDIN_ADS_CURRENCY=USD
# META_ADS_CURRENCY=USD
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# META_APP_ID=
# META_APP_SECRET=
# META_API_VERSION=v25.0
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# TIKTOK_DEFAULT_VIDEO_URL=
# TIKTOK_PUBLISH_DIRECT=0

# Stage 4d archive retention confirm (ISO date)
# ARCHIVE_EXPORT_CONFIRMED_AT=2026-07-20T00:00:00.000Z

# Phase 25 Stage 4e DROP approval (never auto-drops from app)
# SNAPSHOT_DROP_APPROVED_AT=2026-10-20T00:00:00.000Z
# SNAPSHOT_DROP_APPROVED_BY=ops@tagevc.com
# ALLOW_SNAPSHOT_DROP=0
# SNAPSHOT_SOFT_RENAMED_AT=
# SNAPSHOT_RETIRED_TABLE_NAME=
# SNAPSHOT_SOFT_RENAME_APPROVED_AT=
# SNAPSHOT_SOFT_RENAME_APPROVED_BY=
# SNAPSHOT_SOFT_RENAME_SOAK_DAYS=7

# Phase 40–41 snapshot export signing / external retention (server-held)
# SNAPSHOT_EXPORT_HMAC_KEY_ID=snapshot-export-2026-01
# SNAPSHOT_EXPORT_HMAC_KEY=base64_32+_bytes
# SNAPSHOT_EXPORT_HMAC_KEYS={"snapshot-export-2026-01":"base64_32+_bytes"}
# SNAPSHOT_RETENTION_ALLOWED_HOSTS=evidence.example.com
# SNAPSHOT_RETENTION_DESTINATIONS={"archive_primary":{"url":"https://evidence.example.com/object.json","hash_header":"x-evidence-sha256"}}

# Phase 41 externally verifiable ed25519 receipts (PKCS8/SPKI DER base64)
# Publish only PUBLIC keys for offline verify; keep private keys server-side.
# SNAPSHOT_EXPORT_ED25519_KEY_ID=snapshot-ed25519-2026-01
# SNAPSHOT_EXPORT_ED25519_PRIVATE_KEY=base64_pkcs8_der
# SNAPSHOT_EXPORT_ED25519_PUBLIC_KEY=base64_spki_der
# SNAPSHOT_EXPORT_ED25519_PRIVATE_KEYS={"snapshot-ed25519-2026-01":"base64_pkcs8_der"}
# SNAPSHOT_EXPORT_ED25519_PUBLIC_KEYS={"snapshot-ed25519-2026-01":"base64_spki_der"}

# Phase 41 SLO simulation export HMAC (metadata digests only)
# SLO_SIMULATION_EXPORT_HMAC_KEY_ID=slo-sim-export-2026-01
# SLO_SIMULATION_EXPORT_HMAC_KEY=base64_32+_bytes
# SLO_SIMULATION_EXPORT_HMAC_KEYS={"slo-sim-export-2026-01":"base64_32+_bytes"}
# SLO_SIMULATION_EXPORT_RETENTION_DAYS=90

# Phase 42–43 snapshot cold HEAD cadence (hours; default 168)
# Reused for firm-wide verify publish + production cold HEAD schedules.
# SNAPSHOT_COLD_RETENTION_CHECK_CADENCE_HOURS=168
# Production cold HEAD requires SNAPSHOT_RETENTION_DESTINATIONS + ALLOWED_HOSTS above.

# Phase 43 marketing SLO critical ops alerts (reuse SLO webhook allowlist)
# SLO_WEBHOOK_OPS_ALERTS=https://hooks.example.com/slo
# SLO_WEBHOOK_ALLOWED_HOSTS=hooks.example.com
# MARKETING_SLO_ALERT_COOLDOWN_HOURS=24
# MARKETING_CONFLICT_AGING_DAYS=7

# Phase 44 ops alert cooldowns + snapshot canary cadence (reuse SLO webhook allowlist)
# DOCUSIGN_ARCHIVE_ALERT_COOLDOWN_HOURS=24
# INTUNE_OPS_ALERT_COOLDOWN_HOURS=24
# SNAPSHOT_PHASE44_CANARY_CADENCE_HOURS=6
# SNAPSHOT_RETENTION_ALERT_COOLDOWN_HOURS=24

# Phase 45 snapshot consecutive failure paging threshold (default 3)
# SNAPSHOT_CONSECUTIVE_FAILURE_THRESHOLD=3

# Phase 46 snapshot on-call paging (optional; allowlisted via SLO_WEBHOOK_ALLOWED_HOSTS)
# SNAPSHOT_ONCALL_WEBHOOK=https://hooks.example.com/oncall

# Phase 47 on-call acknowledgment SLO (minutes; default 60)
# SNAPSHOT_ONCALL_ACK_SLO_MINUTES=60

# Phase 48 allowlisted owner digest webhooks (JSON map destination_key→HTTPS URL;
# hosts must also appear in SLO_WEBHOOK_ALLOWED_HOSTS). Not full push.
# SLO_OWNER_DIGEST_WEBHOOKS={"owner_digest":"https://hooks.example.com/digest"}

# Phase 48 CI-integrated offline_script dual acceptance for snapshot cutover
# SNAPSHOT_CI_CUTOVER_ENABLED=1

# Phase 49: comma-separated branches that always require CI offline_script
# dual acceptance before ed25519 cutover completes (default main,production;
# the database policy table is the actual enforced source of truth).
# SNAPSHOT_CI_PROTECTED_BRANCH_REQUIRED=main,production

# Phase 50: allowlisted webhook for paging protected_branch_cutover_blocked
# alerts (optional; best-effort — delivery outcome is always recorded via
# page_snapshot_protected_branch_cutover_blocked_phase50, never silently
# dropped). Host must also appear in SLO_WEBHOOK_ALLOWED_HOSTS.
# SNAPSHOT_PHASE50_PAGE_WEBHOOK_URL=https://hooks.example.com/snapshot-oncall
# SNAPSHOT_PHASE50_PAGE_DESTINATION_KEY=oncall

# Phase 50 CI: node scripts/ci-snapshot-phase50-path-guard.mjs --check
# enforces the Phase 48/49 CI offline_script dual-acceptance --check gate
# on PRs touching cutover-adjacent paths. Optionally reuse a prior
# ci-snapshot-cutover-accept.mjs --check exit code in the same job:
# SNAPSHOT_CI_CHECK_EXIT_CODE=0

# Phase 25 MDM offboarding webhook (optional)
# MDM_WEBHOOK_URL=https://mdm.example.com/hooks/offboard
# MDM_WEBHOOK_SECRET=
# Intune retirement has no auto-retire switch; every action requires approval.
# IT_OFFBOARD_MAILBOX_MODE=disable_only
# IT_OFFBOARD_LITIGATION_HOLD=0
# EXCHANGE_AUTOMATION_URL=
# EXCHANGE_AUTOMATION_SECRET=
# Exchange automation must return {"verified":true,"job_id":"..."} only after
# provider-side litigation-hold verification; accepted jobs remain pending.
# MS_GRAPH_SOFT_DELETE_USER=0

# Local only — never enable on Vercel production
# DEV_BYPASS_AUTH=1
