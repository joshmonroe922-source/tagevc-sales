# Supabase (required in production)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_full_not_truncated

# Optional: server-side writes (webhooks, background persist). Prefer this in production.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Phase 9: prefer normalized os_* tables even when empty (read cutover / empty-snapshot drills)
# USE_NORMALIZED_TABLES=1

# Phase 15: snapshot write cutover (reversible; default = dual-write ON)
# WRITE_CUTOVER_MATURE=1
# SNAPSHOT_SKIP_DOMAINS=deal_flow,tickets,documents
# WRITE_SNAPSHOTS=0
# SNAPSHOT_WRITE_DOMAINS=ma,re

# Phase 13: email digests (optional)
# RESEND_API_KEY=re_xxx
# DIGEST_FROM_EMAIL=noreply@tagevc.com
# DIGEST_SECRET=long_random_shared_with_cron
# CRON_SECRET=same_or_separate

# Phase 14–15: protect GET /api/admin/normalization-status (uses DIGEST_SECRET or CRON_SECRET above)

# DocuSign Connect webhook shared secret (header: x-tagevc-webhook-secret)
# DOCUSIGN_WEBHOOK_SECRET=generate_a_long_random_string

# Local only — never enable on Vercel production
# DEV_BYPASS_AUTH=1
